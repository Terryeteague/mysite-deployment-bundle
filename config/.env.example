# ============================================================
# .env.example — Environment Variable Template
# Machine Design AI Assistant
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values for your environment
#   3. NEVER commit .env to version control
#   4. Add .env to your .gitignore
# ============================================================

# ── App ────────────────────────────────────────────────────
APP_NAME="Machine Design AI"
APP_ENV=production          # development | staging | production
APP_URL=https://machinedesignai.com
APP_DEBUG=false             # Set true only in development
APP_PORT=3000               # Local dev server port

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mysite_db
DB_USER=mysite_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true            # true = TLS, false = STARTTLS
SMTP_USER=hello@machinedesignai.com
SMTP_PASS=CHANGE_ME

# ── Contact Form API ───────────────────────────────────────
CONTACT_FORM_ENDPOINT=/api/contact
CONTACT_FORM_TO=hello@machinedesignai.com

# ── Analytics ─────────────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# PLAUSIBLE_DOMAIN=machinedesignai.com  # Uncomment if using Plausible

# ── CDN / Storage ─────────────────────────────────────────
CDN_URL=https://cdn.machinedesignai.com
STORAGE_BUCKET=mysite-assets
STORAGE_REGION=us-east-1

# ── Security ──────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
CSRF_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
CORS_ORIGINS=https://machinedesignai.com,https://www.machinedesignai.com

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX=60           # Max requests per window

# ── Feature Flags ─────────────────────────────────────────
FEATURE_CONTACT_FORM=true
FEATURE_ANALYTICS=true
FEATURE_MAINTENANCE_MODE=false
