# ============================================================
# .env.example — Environment Variable Template
# MySite Deployment Bundle
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values for your environment
#   3. NEVER commit .env to version control
#   4. Add .env to your .gitignore
# ============================================================

# App
APP_NAME="MySite"
APP_ENV=production
APP_URL=https://mysite.com
APP_DEBUG=false
APP_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mysite_db
DB_USER=mysite_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=hello@mysite.com
SMTP_PASS=CHANGE_ME

# Contact Form API
CONTACT_FORM_ENDPOINT=/api/contact
CONTACT_FORM_TO=hello@mysite.com

# Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# PLAUSIBLE_DOMAIN=mysite.com

# CDN / Storage
CDN_URL=https://cdn.mysite.com
STORAGE_BUCKET=mysite-assets
STORAGE_REGION=us-east-1

# Security
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
CSRF_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
CORS_ORIGINS=https://mysite.com,https://www.mysite.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Feature Flags
FEATURE_CONTACT_FORM=true
FEATURE_ANALYTICS=true
FEATURE_MAINTENANCE_MODE=false
