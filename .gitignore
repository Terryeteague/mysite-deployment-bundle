# ============================================================
# .gitignore — MySite
# ============================================================

# ── Environment & Secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
secrets/
private/

# ── OS Files ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Editors & IDEs ─────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Node.js ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
dist/
build/
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/

# ── Docker ─────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ── Logs ───────────────────────────────────────────────────────────
logs/
*.log
*.log.*
log/

# ── Coverage & Testing ─────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ── Temporary & Cache ──────────────────────────────────────────
tmp/
temp/
.tmp/
.temp/
*.tmp
*.bak
*.orig

# ── Deployment Artifacts ───────────────────────────────────────
.netlify/
.vercel/
.serverless/
.terraform/
*.tfstate
*.tfstate.*

# ── Source Maps ────────────────────────────────────────────────
*.map

# ── Miscellaneous ────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
.sass-cache/
jspm_packages/
